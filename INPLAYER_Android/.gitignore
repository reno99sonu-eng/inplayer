# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Nested plugin packages (packages/ivs_broadcast) run their own Gradle build,
# and its artifacts are NOT covered by the /build/ and .dart_tool/ rules above
# — those are anchored to this project root. Without these, every build
# rewrites lock files and caches that then show up as repo changes.
**/.gradle/
packages/*/android/build/
packages/*/.dart_tool/
packages/*/build/

# Transfer artifacts for the bundled age model. The joined
# assets/models/fairface_age_int8.tflite IS committed (the app will not build
# without it); these split pieces are scaffolding and must never be, or the
# same 21 MB lands in the repo twice.
assets/models/*.part*
